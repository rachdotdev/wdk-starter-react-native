+// Derived accounts, per WDK instance. Deriving a wallet from its seed is slow on
+// device, and every balance call used to derive it again, so concurrent balance
+// calls ran past the app's network timeout. An entry is reused only while the
+// wallet manager it came from is still registered. After wdk.dispose() or a
+// re-register, `_wallets` holds a different manager, so the entry is rebuilt.
+const accountCache = new WeakMap()
+
+async function getCachedAccount (wdk, network, accountIndex) {
+  const manager = wdk._wallets?.get(network)
+  if (!manager) return wdk.getAccount(network, accountIndex)
+
+  let byKey = accountCache.get(wdk)
+  if (!byKey) {
+    byKey = new Map()
+    accountCache.set(wdk, byKey)
+  }
+
+  const key = `${network}:${accountIndex}`
+  const cached = byKey.get(key)
+  if (cached && cached.manager === manager) return cached.account
+
+  const pending = wdk.getAccount(network, accountIndex)
+  byKey.set(key, { manager, account: pending })
+  try {
+    return await pending
+  } catch (error) {
+    byKey.delete(key)
+    throw error
+  }
+}
