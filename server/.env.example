# Candide dashboard → API Keys → "Forwarder addresses" URL. It embeds your
# team API key, which is billed. Server only.
CANDIDE_FORWARDING_API_URL=
# Candide dashboard → Forwarder Policies → your policy → Bearer Token.
# Activates and renews addresses, which is billed. Server only.
CANDIDE_FORWARDING_POLICY_SECRET=
# Optional: a company wallet that can recover stuck funds after a timelock.
# Leave empty to make the recipient the only withdrawer (fully self-custodial).
# Changing it later changes every deposit address.
CANDIDE_RECOVERY_WITHDRAWER=
# Random 32-byte hex (e.g. `openssl rand -hex 32` with a 0x prefix). Used to
# derive each user's salt so deposit addresses can't be linked to wallets.
# Changing it later changes every deposit address.
SDA_SALT_SECRET=
# Where deposits settle, and which chains users can send from.
SDA_DESTINATION_CHAIN=arbitrum
SDA_SOURCE_CHAINS=ethereum,polygon
# Tokens shown to users as accepted (Tether assets only). Other tokens the
# Candide policy forwards are not shown.
SDA_ACCEPTED_SYMBOLS=USDT,USDT0,XAUT0
# Renew monitoring when less than this many seconds are left.
SDA_RENEW_WITHIN_SECONDS=86400
PORT=8787
